{
  "expo": {
    "name": "Плёнка",
    "slug": "plenka",
    "scheme": "plenka",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "dev.akiradude.plenka",
      "adaptiveIcon": {
        "backgroundColor": "#2B48D6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Плёнке нужна камера, чтобы снимать фото для записей.",
          "microphonePermission": false
        }
      ],
      "./plugins/withFragileUserData",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Плёнка запоминает, где сделана запись, чтобы показать её на карте.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2143c61d-bdcc-4d7f-8c50-f422984e33c1"
      }
    },
    "owner": "akira-dude"
  }
}
